  <disable_collisions link1="fr3_link5" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="fr3_link5" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="fr3_link5" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="fr3_link5" link2="ur_to_robotiq_link" reason="Never"/>
  <disable_collisions link1="fr3_link6" link2="fr3_link7" reason="Adjacent"/>
  <disable_collisions link1="fr3_link6" link2="robotiq_85_base_link" reason="Adjacent"/>
