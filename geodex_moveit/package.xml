<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>geodex_moveit</name>
  <version>1.0.0</version>
  <description>MoveIt 2 planner plugin for sampling-based planning on Riemannian configuration spaces with geodex.</description>
  <maintainer email="phone.thiha@robotics.utias.utoronto.ca">Phone Thiha Kyaw</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/utiasSTARS/geodex_moveit</url>
  <author email="phone.thiha@robotics.utias.utoronto.ca">Phone Thiha Kyaw</author>
  <author email="ben.wei@robotics.utias.utoronto.ca">Ben Wei</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>generate_parameter_library</build_depend>
  <!-- scripts/build_deps.sh builds geodex and its OMPL fork from source into their own prefix. -->
  <build_depend>geodex</build_depend>
  <build_depend>yaml-cpp</build_depend>

  <depend>moveit_core</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>moveit_planners_ompl</test_depend>
  <test_depend>moveit_resources_panda_description</test_depend>
  <test_depend>moveit_resources_panda_moveit_config</test_depend>
  <test_depend>moveit_ros_planning</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
