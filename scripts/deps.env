# This file pins the geodex source that the build fetches. geodex pins the OMPL fork and VAMP in
# third_party/dependencies.cmake and builds them during its install. A non-empty variable of the
# same name in the environment overrides the pin, and GEODEX_SOURCE_DIR replaces it with a local
# tree.

GEODEX_REPO="${GEODEX_REPO:-https://github.com/utiasSTARS/geodex.git}"
GEODEX_REF="${GEODEX_REF:-v1.0.0}"
